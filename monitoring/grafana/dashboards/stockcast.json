      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{job=\"stockcast_api\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
