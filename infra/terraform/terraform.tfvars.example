aws_region        = "us-east-1"
project_name      = "tech-challenge-5"
environment       = "dev"

db_name           = "mlflow"
db_username       = "mlflowadmin"
db_password       = "CHANGE_ME_SECURE_PASSWORD"

db_instance_class   = "db.t4g.micro"
db_allocated_storage = 20

container_port      = 8000
task_cpu            = 4096
task_memory         = 8192
desired_count       = 1
container_image_tag = "latest"
health_check_path   = "/health"
drift_schedule_expression = "cron(0 3 * * ? *)"
drift_ticker              = "BTC-USD"
llm_metrics_namespace     = "StockCast/LLM"
llm_alarm_email           = "mlops-alerts@example.com"
