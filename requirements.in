# opentelemetry-proto>=1.28 requires protobuf>=5, which conflicts with
# tensorflow 2.x (requires protobuf<5). This upper bound is mandatory.
opentelemetry-proto<1.28

# datasets 4.x requires fsspec<=2026.2.0; pin here so requirements.txt and
# requirements.eval.txt are compiled with the same fsspec version.
fsspec<=2026.2.0
