# MLflow
MLFLOW_TRACKING_URI=postgresql://user:pass@host:5432/mlflow
MLFLOW_EXPERIMENT_NAME=btc-price-prediction
MLFLOW_ARTIFACT_URI=s3://mlflow-artifacts/btc-hourly-forecast

# S3 para armazenamento de modelos treinados
# Se não definido, usa fallback local (pasta models/)
S3_MODELS_BUCKET=tech-challenge-5-trained-models

# Governança de metadata no treino (MLflow tags/model registry)
MLFLOW_MODEL_NAME=btc_hourly_forecaster
MLFLOW_MODEL_VERSION=v1
MLFLOW_OWNER=ml-team
MLFLOW_RISK_LEVEL=medium
# training_data_version é gerado automaticamente por lineage imutável (git_sha:dvc_data_hash).
# Esta variável não é consumida diretamente pelo treino e deve permanecer apenas como referência.
MLFLOW_TRAINING_DATA_VERSION=gitsha123:deadbeefcafebabe1234567890abcdef

# Runtime environment
APP_ENV=development

# Bedrock AI
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
AGENT_LLM_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
AGENT_LLM_TEMPERATURE=0
AGENT_LLM_TOP_P=
AGENT_LLM_TOP_K=
RAGAS_LLM_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
RAGAS_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
RAGAS_LLM_TEMPERATURE=0
RAGAS_LLM_TOP_P=
RAGAS_LLM_TOP_K=
LLM_JUDGE_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
LLM_JUDGE_TEMPERATURE=0
LLM_JUDGE_TOP_P=
LLM_JUDGE_TOP_K=
RAG_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# AWS
AWS_REGION=us-east-1
ECR_REPOSITORY=your-ecr-repo
ECS_CLUSTER=your-ecs-cluster

# Langfuse (opcional)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# App
APP_PORT=8000
